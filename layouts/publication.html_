---
layout: default
---
<article class="publication">
  <h1>{{ page.title }}</h1>
  <p class="muted">{{ page.authors }} — {{ page.venue }} ({{ page.year }})</p>
  {% if page.url_external %}
  <p><a href="{{ page.url_external }}">View publication</a></p>
  {% endif %}
  <section>
    {{ content }}
  </section>
</article>
