<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ page.title }} | {{ site.title }}</title>
  <meta name="description" content="{{ page.excerpt | strip_html | strip_newlines | default: site.description }}">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
</head>
<body>
  {% include header.html %}
  <main class="container">
    <div class="content">
      {{ content }}
    </div>
    <aside class="sidebar">
      <h3>About</h3>
      <p>{{ site.description }}</p>
      <h3>Contact</h3>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </aside>
  </main>
  {% include footer.html %}
</body>
</html>
