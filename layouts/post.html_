---
layout: default
---
<section class="hero">
  <h1>{{ site.title }}</h1>
  <p>{{ site.description }}</p>
</section>

<section class="recent-posts">
  <h2>Recent posts</h2>
  <ul>
    {% for post in site.posts limit:5 %}
    <li>
      <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
      <small class="muted">— {{ post.date | date: "%Y-%m-%d" }}</small>
    </li>
    {% endfor %}
  </ul>
  <p><a href="/blog/">See all posts</a></p>
</section>

<section class="recent-publications">
  <h2>Recent publications</h2>
  <ul>
    {% for pub in site.publications limit:5 %}
    <li>
      <a href="{{ pub.url | relative_url }}">{{ pub.title }}</a>
      <small class="muted">— {{ pub.authors }}</small>
    </li>
    {% endfor %}
  </ul>
  <p><a href="/publications/">See all publications</a></p>
</section>
